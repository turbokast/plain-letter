# Copy to .env.local (not committed). Without VITE_FIREBASE_CONFIG the app runs
# on-device only and shows a fixed demo answer for the cloud step.

# The Firebase web app config object, as one line of JSON.
VITE_FIREBASE_CONFIG=

# App Check. Site key for the hosted build (reCAPTCHA v3, or Enterprise with VITE_APPCHECK_ENTERPRISE=1).
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_ENTERPRISE=
# Debug token for local development and test builds (register it in the Firebase console first).
VITE_APPCHECK_DEBUG_TOKEN=

# Cloud model name. Empty = gemini-3.5-flash-lite (the SDK's default for hybrid inference).
VITE_CLOUD_MODEL=
